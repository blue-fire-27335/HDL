module tb_logic_gates;
  reg a,b;
  wire y_and,y_or,not_a,y_nand,y_nor,y_xor,y_xnor;
  logic_gates dut(  .a(a),.b(b),.y_and(y_and),.y_or(y_or),.not_a(not_a),.y_nand(y_nand),.y_nor(y_nor),.y_xor(y_xor),.y_xnor(y_xnor) );
  initial begin
    $monitor("a=%b b=%b and=%b or=%b not=%b nand=%b nor=%b xor=%b xnor=%b",a,b,y_and,y_or,not_a,y_nand,y_nor,y_xor,y_xnor);
    $dumpfile("logic_gates.vcd");
    $dumpvars(0,tb_logic_gates);
    #10 a=0; b=0;
    #10 a=0; b=1;
    #10 a=1; b=0;
    #10 a=1; b=1;
    #10 $finish;
  end
endmodule
